# UI Features
NEXT_PUBLIC_ENABLE_DONATIONS=true 

# Real-time Features
NEXT_PUBLIC_REALTIME_EPHEMERAL_ENABLED=true
NEXT_PUBLIC_REALTIME_JOB_ENABLED=true
NEXT_PUBLIC_REALTIME_PERMANENT_ENABLED=true
NEXT_PUBLIC_REALTIME_POST_DETAILS_ENABLED=true
NEXT_PUBLIC_GRANULAR_REALTIME_ENABLED=true
REALTIME_VOTE_STATS_ENABLED=true
REALTIME_REPLIES_ENABLED=true
NEXT_PUBLIC_ALLOW_MULTI_TAB=true
NEXT_PUBLIC_IDLE_TIMEOUT_MS=300000

# Post lifespan
NEXT_PUBLIC_POST_SURVIVAL_HOURS=24
NEXT_PUBLIC_POST_MAX_LIFETIME_DAYS=180
NEXT_PUBLIC_POST_FEED_LIMIT=0
NEXT_PUBLIC_POST_CHAR_LIMIT=200

# Community Purification Settings
NEXT_PUBLIC_PURIFICATION_MIN_VOTES=0
NEXT_PUBLIC_PURIFICATION_DOWNVOTE_RATIO=0
NEXT_PUBLIC_PURIFICATION_METER_THRESHOLD=0.

# Content Similarity
SIMILARITY_CHECK_ENABLED=true
SIMILARITY_THRESHOLD=0
SIMILARITY_CHECK_HOURS=0

# Link Handling
NEXT_PUBLIC_WHITELISTED_DOMAINS=xxx

# Rate Limiting
POST_COOLDOWN_MINUTES=0
COMMENT_COOLDOWN_SECONDS=0
REPLY_COOLDOWN_MINUTES=0
REPLY_LIMIT_PER_POST=0

# Supabase
NEXT_PUBLIC_SUPABASE_CHANNEL_NAME=post_room
NEXT_PUBLIC_SUPABASE_JOB_CHANNEL_NAME=job_room
NEXT_PUBLIC_SUPABASE_PERMANENT_CHANNEL_NAME=permanent_room
NEXT_PUBLIC_SUPABASE_URL=xxx
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxx
DATABASE_URL="xxx"
DIRECT_URL=xxx

# Admin credentials
JWT_SECRET_KEY=xxx
CRON_SECRET=xxx
ADMIN_USERNAME=xxx
ADMIN_PASSWORD=xxx

